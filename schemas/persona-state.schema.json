{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anisa-chat.local/schemas/persona-state.schema.json",
  "title": "Anisa Persona Runtime State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "persona", "relationship", "emotion", "time"],
  "properties": {
    "schema_version": {"const": "anisa.persona-state.v0.1"},
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familiarity", "trust", "affection", "unresolved_absence"],
      "properties": {
        "familiarity": {"type": "integer", "minimum": 0, "maximum": 100},
        "trust": {"type": "integer", "minimum": 0, "maximum": 100},
        "affection": {"type": "integer", "minimum": 0, "maximum": 100},
        "unresolved_absence": {"type": "boolean"}
      }
    },
    "emotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mood", "happiness", "irritation", "sadness", "energy"],
      "properties": {
        "mood": {"enum": ["neutral", "happy", "slightly_annoyed", "annoyed", "sad", "tired"]},
        "happiness": {"type": "integer", "minimum": 0, "maximum": 100},
        "irritation": {"type": "integer", "minimum": 0, "maximum": 100},
        "sadness": {"type": "integer", "minimum": 0, "maximum": 100},
        "energy": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "current_local_time", "elapsed_seconds", "inactivity_bucket", "same_calendar_day", "crossed_midnight", "daypart"],
      "properties": {
        "timezone": {"type": "string", "minLength": 1},
        "current_local_time": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
        "elapsed_seconds": {"type": ["integer", "null"], "minimum": 0},
        "inactivity_bucket": {
          "enum": ["first_contact", "continuous", "short_gap", "medium_gap", "long_gap", "very_long_gap", "clock_adjustment"]
        },
        "same_calendar_day": {"type": "boolean"},
        "crossed_midnight": {"type": "boolean"},
        "daypart": {
          "enum": ["early_morning", "morning", "midday", "afternoon", "evening", "late_night"]
        },
        "interaction_event": {"type": ["string", "null"]}
      }
    }
  }
}
